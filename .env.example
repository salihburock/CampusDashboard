# Copy this file to .env and fill in the values. Never commit .env.

# Required: long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: password for the admin account created on first run.
# If empty, a random password is generated and printed to the console.
ADMIN_PASSWORD=

# Optional
PORT=3000
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
GEMINI_API_KEY=

# Optional: your university's Moodle (e.g. https://lms.example.edu). When set,
# users can connect Moodle on the Account page and pull courses, upcoming
# deadlines and grades with "Sync from Moodle" in the editor.
MOODLE_URL=
# Optional: files larger than this (MB) are skipped by the Moodle file sync.
MOODLE_MAX_FILE_MB=200

# Optional: the webservice token sync (above) needs campus-trusted IPs for
# some institutions. If it 403s, set these to drive a headless Chrome
# (system-installed, see CHROME_PATH) that logs in and scrapes course pages
# instead. MFA on every login will break this; it's meant for setups where
# MFA is only occasionally prompted.
MOODLE_USERNAME=
MOODLE_PASSWORD=
# Which dashboard user's data the browser sync updates.
MOODLE_SYNC_OWNER=salih
# How often it runs, in hours.
MOODLE_BROWSER_SYNC_HOURS=4
# Path to an installed Chrome/Chromium binary.
CHROME_PATH=/usr/bin/google-chrome

# Optional: video conversion uses the GPU's H.264 encoder when it finds one
# (NVIDIA NVENC, then Intel QuickSync). Set to "none" to always use the CPU.
VIDEO_HWENC=auto
