# Copy this file to .env and fill in the values. Never commit .env.

# Required: long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: password for the admin account created on first run.
# If empty, a random password is generated and printed to the console.
ADMIN_PASSWORD=

# Optional
PORT=3000
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
GEMINI_API_KEY=

# Ozyegin University credentials (used to log into lms.ozyegin.edu.tr via
# Microsoft Entra ID / SSO). This account's password, so keep .env out of git
# (it already is, via .gitignore).
LMS_USERNAME=your-email@ozyegin.edu.tr
LMS_PASSWORD=

# MFA relay (github.com salih/mfa-relay), hosted on the "ns" VPS.
# Full base URL including scheme + port, no trailing slash, e.g.:
#   MFA_RELAY_URL=http://your-vps.example.com:8030
MFA_RELAY_URL=
# Shared token the relay expects in the X-MFA-Token header (MFA_RELAY_API_TOKEN
# in the relay's own .env).
MFA_RELAY_TOKEN=

# Set to "true" to run the browser headed (useful when debugging selectors).
LMS_HEADFUL=false
