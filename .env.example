# Copy this file to .env and fill in the values. Never commit .env.

# Required: long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: password for the admin account created on first run.
# If empty, a random password is generated and printed to the console.
ADMIN_PASSWORD=

# Optional
PORT=3000
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
GEMINI_API_KEY=
# Optional: OpenAI-compatible chat API tried first (before Ollama/Gemini) to
# pick each course's syllabus from its filenames; only the course code and
# filenames are sent. E.g. https://evren-llmapi.ssyz.org.tr/v1 with
# deepseek-v4.1-flash (10/10 in a comparison where llama3.2:3b got 6/10).
LLM_API_URL=
LLM_API_KEY=
LLM_API_MODEL=

# Optional: your university's Moodle (e.g. https://lms.example.edu). When set,
# users can connect Moodle on the Account page and pull courses, upcoming
# deadlines and grades with "Sync from Moodle" in the editor.
MOODLE_URL=
# Optional: files larger than this (MB) are skipped by the Moodle file sync.
MOODLE_MAX_FILE_MB=200

# Optional: the webservice token sync (above) needs campus-trusted IPs for
# some institutions. If it 403s, set these to drive a headless Chrome
# (system-installed, see CHROME_PATH) that logs in and scrapes course pages
# instead. MFA on every login will break this; it's meant for setups where
# MFA is only occasionally prompted. It never runs on its own: only when
# triggered (POST /api/moodle/browser-sync).
MOODLE_USERNAME=
MOODLE_PASSWORD=
# Which dashboard user's data the browser sync updates.
MOODLE_SYNC_OWNER=salih
# Path to an installed Chrome/Chromium binary.
CHROME_PATH=/usr/bin/google-chrome
# Optional: mfa-relay (self-hosted Microsoft Authenticator number-match
# relay, see ~/gits/mfa-relay) so an occasional MFA prompt during the
# browser sync's login can be approved automatically instead of needing a
# human with the phone. MFA_RELAY_URL is that service's base URL.
MFA_RELAY_URL=
MFA_RELAY_TOKEN=

# Optional: video conversion uses the GPU's H.264 encoder when it finds one
# (NVIDIA NVENC, then Intel QuickSync). Set to "none" to always use the CPU.
VIDEO_HWENC=auto

# Optional: lets scripts/agent.js (run on this machine, e.g. over SSH by an AI
# agent) use the API as AGENT_USER without a password. Loopback only.
# Generate the token like SESSION_SECRET. Leave empty to turn this off.
AGENT_USER=
AGENT_TOKEN=

# Optional: check grades every hour (on the hour) over plain HTTP with the
# browser sync's saved session, and send changes to Telegram. Off unless "on".
MOODLE_GRADE_WATCH=
# Telegram bot that sends grade changes, and the one chat that receives them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# "on" to take commands (/status, /pause, /interval 2h, /check, /sync, ...)
# from TELEGRAM_CHAT_ID. Telegram gives a bot's messages to one listener only,
# so use a bot no other program reads updates from.
TELEGRAM_COMMANDS=
